{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Sync to Pi",
            "type": "shell",
            "command": "bash",
            "args": [".vscode/sync.sh"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build ggk (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${workspaceFolder}",
                "bash",
                ".vscode/build.sh"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
